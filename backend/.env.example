# Environment name (development | staging | production)
STAGE=development
# Port the API listens on
PORT=3001
# Origin allowed to call this API (the Vue frontend's dev/build URL)
CORS_ORIGIN=http://127.0.0.1:3000

# --- Database (MySQL) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=arden_roofing

# --- Leads notification (optional) ---
# Address that receives a copy of every lead form submission.
LEAD_NOTIFICATION_EMAIL=sales@ardenroofing.com
